# PersonaLive Environment Configuration

# 1. Google Gemini API (Required for Voice & Logic)
# Obtain from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key

# 2. Google OAuth (Required for Notebook Cloud Brain)
# Create a Google Cloud Project and OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
SESSION_SECRET=a_random_unique_string_for_session_encryption

# 3. Tailscale (Optional - for bridge functionality)
# Obtain a tailnet name and API key with "Devices: Read" permissions
TAILSCALE_API_KEY=tskey-api-xxxxxxxx
TAILSCALE_TAILNET=your-tailnet-name.ts.net
TAILSCALE_HOSTNAME=

# 4. Firebase (Injected by platform tool)
# These are automatically handled if you use the 'Setup Firebase' tool
# or provided in firebase-applet-config.json

# 5. Camelot-OS Runtime
CAMELOT_SIGNING_SECRET=change-me-to-a-long-random-secret
CAMELOT_OS_HOME=/path/to/camelot
CAMELOT_DEFAULT_SIGNER=sir_aurelius
CAMELOT_DEFAULT_SOURCE=cli

# 6. Supabase command queue / ledger / memory refs
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key

# 7. Bifrost Bridge (Sir Heimdall) — governed remote access
# The gatekeeper daemons and the broker share CAMELOT_SIGNING_SECRET as
# BIFROST_SIGNING_SECRET. Minimum 16 characters; the daemons refuse to start below that.
BIFROST_SIGNING_SECRET=change-me-to-a-long-random-secret
# Shared token for the Go broker's write endpoints (X-Bifrost-Token).
BIFROST_BROKER_TOKEN=change-me-to-a-long-random-token
BIFROST_BROKER_BIND=:8080
# Revocation fan-out map: deviceId=url,deviceId=url
BIFROST_NODE_ENDPOINTS=
# Node-side gatekeeper (services/heimdall-gatekeeper)
HEIMDALL_DEVICE_ID=desktop_primary
HEIMDALL_TRANSPORT=rustdesk_control
HEIMDALL_BIND=127.0.0.1:8777
HEIMDALL_HEARTBEAT_SECONDS=30
BIFROST_BROKER_URL=

# 8. Optional external services
OMNIROUTE_BASE_URL=http://localhost:20128/v1
ROTEL_ENDPOINT=http://localhost:4318
MODAL_PROFILE=
