# PersonaLive Environment Configuration

# 1. Google Gemini API (Required for Voice & Logic)
# Obtain from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key

# 2. Google OAuth (Required for Notebook Cloud Brain)
# Create a Google Cloud Project and OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
SESSION_SECRET=a_random_unique_string_for_session_encryption

# 3. Tailscale (Optional - for bridge functionality)
# Obtain a tailnet name and API key with "Devices: Read" permissions
TAILSCALE_API_KEY=tskey-api-xxxxxxxx
TAILSCALE_TAILNET=your-tailnet-name.ts.net

# 4. Firebase (Injected by platform tool)
# These are automatically handled if you use the 'Setup Firebase' tool
# or provided in firebase-applet-config.json

# 5. Mistral Voxtral Voice (Sir Heimdall + Sir Hermes) — server-side only
# Obtain from Mistral La Plateforme (console.mistral.ai). NEVER expose this
# key to the browser; the server routes /api/voice/mistral/* use it.
# Voxtral is paid per character/minute — /speak requires confirmPaid: true.
MISTRAL_API_KEY=your_mistral_api_key
# Bifrost Bridge (Atom gateway on the Hermes VPS). On the VPS itself use
# http://127.0.0.1:8180 ; from the tailnet use http://100.92.0.44:8180
BIFROST_BRIDGE_URL=http://127.0.0.1:8180
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
MISTRAL_STT_MODEL=voxtral-mini-2602
# Optional per-knight preset voices (Mistral Studio preset UUID or alias).
# Defaults to the documented alias en_paul_neutral for both knights.
MISTRAL_VOICE_HEIMDALL=en_paul_neutral
MISTRAL_VOICE_HERMES=en_paul_neutral

# 6. Excalibur Command Center (Optional — live probe configuration)
# Public BoB gateway health URL probed server-side by /api/excalibur/status.
# Defaults to https://bob.lisascustomkeychains.com/health when unset.
BOB_GATEWAY_URL=https://bob.lisascustomkeychains.com/health
# Optional tailnet bridge base URL for the Excalibur command center.
# Its mere presence is reported as configured: true in /api/excalibur/status;
# VPS loopback services are never probed from this server (Watchtower verifies them).
EXCALIBUR_BRIDGE_URL=http://<tailnet-ip>:8182
