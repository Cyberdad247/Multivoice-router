{
  "entities": {
    "Persona": {
      "title": "AI Persona",
      "description": "Configuration for a specific AI persona including voice, instructions, and tools.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "description": { "type": "string" },
        "voice": { "type": "string", "enum": ["Puck", "Charon", "Kore", "Fenrir", "Zephyr"] },
        "systemInstruction": { "type": "string" },
        "attributes": {
          "type": "object",
          "properties": {
            "tone": { "type": "string" },
            "expertise": { "type": "array", "items": { "type": "string" } },
            "personality": { "type": "string" }
          }
        },
        "memory": { "type": "array", "items": { "type": "string" } },
        "traits": { "type": "array", "items": { "type": "string" } },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["url", "file"] },
              "name": { "type": "string" },
              "content": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        },
        "notebookConfig": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "id": { "type": "string" },
            "name": { "type": "string" },
            "lastSynced": { "type": "string", "format": "date-time" }
          }
        },
        "bridgeConfig": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "ip": { "type": "string" },
            "port": { "type": "integer" },
            "protocol": { "type": "string", "enum": ["http", "https"] }
          }
        },
        "rustDeskConfig": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "id": { "type": "string" },
            "password": { "type": "string" },
            "server": { "type": "string" }
          }
        },
        "baseVoiceSampleId": { "type": "string" },
        "baseVoiceSampleUrl": { "type": "string" },
        "ownerId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "role", "ownerId"]
    },
    "VoiceSample": {
      "title": "Knight Voice Sample",
      "description": "Custom recorded or uploaded audio snippet stored in Firebase Storage serving as base voice reference for a knight persona.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "personaId": { "type": "string" },
        "name": { "type": "string" },
        "storagePath": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "duration": { "type": "number" },
        "mimeType": { "type": "string" },
        "size": { "type": "number" },
        "isBaseReference": { "type": "boolean" },
        "transcript": { "type": "string" },
        "notes": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "personaId", "name", "storagePath", "downloadUrl", "ownerId"]
    },
    "Transcript": {
      "title": "Conversation Transcript",
      "description": "Log of a specific voice interaction session.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "personaId": { "type": "string" },
        "ownerId": { "type": "string" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "model"] },
              "text": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "personaId", "ownerId"]
    },
    "VocalLicense": {
      "title": "Sovereign Vocal License",
      "description": "Cryptographic vocal rights deed and timbre watermark certification from Vocal-license-engine.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "personaId": { "type": "string" },
        "licenseType": { "type": "string", "enum": ["sanctuary", "sovereign", "commercial", "royal"] },
        "licensee": { "type": "string" },
        "timbreHash": { "type": "string" },
        "c2paSigned": { "type": "boolean" },
        "watermarkKey": { "type": "string" },
        "rights": { "type": "array", "items": { "type": "string" } },
        "terms": { "type": "string" },
        "royaltyBps": { "type": "number" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "personaId", "licenseType", "licensee", "timbreHash", "ownerId"]
    },
    "ArtemisTestRun": {
      "title": "Google Artemis Test Run",
      "description": "Autonomous device test execution trace and verification benchmark from Google Artemis.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "personaId": { "type": "string" },
        "taskPrompt": { "type": "string" },
        "status": { "type": "string", "enum": ["passed", "failed", "running"] },
        "successRate": { "type": "number" },
        "actionsExecuted": { "type": "array" },
        "deviceTarget": { "type": "string" },
        "logs": { "type": "array", "items": { "type": "string" } },
        "screenshotUrl": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "personaId", "taskPrompt", "status", "ownerId"]
    }
  },
  "firestore": {
    "/personas/{personaId}": {
      "schema": "Persona",
      "description": "User created AI personalities."
    },
    "/transcripts/{transcriptId}": {
      "schema": "Transcript",
      "description": "History of voice conversations."
    },
    "/voice_samples/{sampleId}": {
      "schema": "VoiceSample",
      "description": "Recorded and uploaded knight voice audio reference samples stored in Firebase Storage."
    },
    "/vocal_licenses/{licenseId}": {
      "schema": "VocalLicense",
      "description": "Sovereign vocal licensing deeds and cryptographic timbre hashes."
    },
    "/artemis_test_runs/{runId}": {
      "schema": "ArtemisTestRun",
      "description": "Google Artemis autonomous device automation and benchmark test runs."
    }
  }
}
